# Maintainer: Miguel Sanz <123277580+MiguelSanzBr@users.noreply.github.com>
pkgname=attackshark-x11
_tag=0.1.0-beta.1
pkgver=0.1.0beta1
pkgrel=1
pkgdesc="Open-source Linux configurator for the ATTACK SHARK X11 wireless mouse (CLI + GUI)"
arch=('any')
url="https://github.com/MiguelSanzBr/attackshark-x11-linux"
license=('MIT')
depends=('python' 'tk' 'hicolor-icon-theme')   # tk: the GUI (tkinter)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
install=attackshark-x11.install
source=("$pkgname-$_tag.tar.gz::$url/archive/refs/tags/v$_tag.tar.gz")
sha256sums=('e2881e8890ac7db2bd074a3a5c136fa8b9556a9f6574bc8cb13602c16828ab12')

build() {
  cd "attackshark-x11-linux-$_tag"
  python -m build --wheel --no-isolation
}

package() {
  cd "attackshark-x11-linux-$_tag"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 udev/70-attackshark-x11.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 packaging/x11gui.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/sharkx11.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
